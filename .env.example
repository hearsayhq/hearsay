# Only needed for orchestrator=llm and `hearsay gen-variants`. scripted and replay runs need no keys.
AWS_REGION=us-east-1
HEARSAY_BEDROCK_MODEL_ID=         # a model with tool use enabled in your Bedrock account
HEARSAY_POLLY_VOICE=Joanna        # gen-variants: en-US voice
# Fallback only if Bedrock access fails (R-06, FR-014 cut):
# HEARSAY_PROVIDER=anthropic | openai-compatible
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
