# Only needed for orchestrator=llm. scripted and replay modes need no keys.
EARSHOT_PROVIDER=bedrock          # bedrock | anthropic | openai-compatible
AWS_REGION=us-east-1
EARSHOT_BEDROCK_MODEL_ID=         # pick a model with tool use enabled in your Bedrock account
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=       # e.g. DeepSeek
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
