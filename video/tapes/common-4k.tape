# Shared look for the v4 tapes: the same real bash in a fresh clone as common.tape, recorded at 4K
# so the film can move its camera into the output and the text stays sharp.
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 30
Set Width 3840
Set Height 2160
Set Padding 72
Set Framerate 30
Set TypingSpeed 18ms
Set Theme { "name": "hearsay", "black": "#0d1117", "red": "#ff8a80", "green": "#3ddc97", "yellow": "#f2c14e", "blue": "#7c9bff", "magenta": "#bc8cff", "cyan": "#7fe0c7", "white": "#c9d1d9", "brightBlack": "#6e7681", "brightRed": "#ffa198", "brightGreen": "#56d364", "brightYellow": "#ffaa2b", "brightBlue": "#a5b4ff", "brightMagenta": "#d2a8ff", "brightCyan": "#a5f0de", "brightWhite": "#f4f6fa", "background": "#0a1020", "foreground": "#c9d1d9", "selection": "#1f2a44", "cursor": "#ffaa2b" }
